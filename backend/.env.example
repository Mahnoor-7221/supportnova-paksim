# SupportNova environment configuration
APP_ENV=development
DEBUG=true

# SQLite is the default. Change this only if using PostgreSQL/MySQL.
# DATABASE_URL=sqlite:///./supportnova.db

# Security - change in any real deployment.
SECRET_KEY=change-this-secret-key

# AI provider: lovable, gemini or offline
AI_PROVIDER=lovable
LOVABLE_API_KEY=
LOVABLE_MODEL=openai/gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend development origin(s)
CORS_ORIGINS=http://localhost:5173

# Demo data
SEED_ON_STARTUP=true
